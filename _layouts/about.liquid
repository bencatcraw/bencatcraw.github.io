---
layout: default
---
<div class="about-clean">
  <!-- Projects in a single ordered feed -->
  {% assign ordered_projects = site.projects | sort: "date" | reverse %}
  {% if ordered_projects and ordered_projects.size > 0 %}
    <div class="about-project-feed">
      {% for project in ordered_projects %}
        {% include project_feed_post.liquid %}
      {% endfor %}
    </div>
  {% endif %}
</div>
