---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% assign is_project = false %}
{% if page.collection == 'projects' %}
  {% assign is_project = true %}
{% endif %}

<div class="post">
  <header class="post-header post-header-split">
    <div class="post-header-title">
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </div>
    {% if is_project and page.date %}
      <div class="post-header-meta">
        <time class="post-date" datetime="{{ page.date | date_to_xmlschema }}">{% include project_date.liquid project=page %}</time>
      </div>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if is_project %}
    <footer class="post-footer">
      <a class="btn-outline-hairline" href="{{ '/portfolio/' | relative_url }}">Back to Portfolio</a>
      {% if page.category %}
        <a class="post-footer-stat" href="{{ '/portfolio/' | relative_url }}#{{ page.category }}">{{ page.category }}</a>
      {% endif %}
    </footer>
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
