<div class="col">
  <a class="project-tile" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    {% if project.img %}
      <div class="project-tile-image">
        {%
          include figure.liquid
          loading="lazy"
          path=project.img
          sizes="(min-width: 992px) 420px, (min-width: 576px) 50vw, 95vw"
          alt=project.title
        %}
      </div>
    {% endif %}
    <div class="project-tile-caption">
      <h2 class="project-tile-title">{{ project.title }}</h2>
      {% if project.date or project.description %}
        <p class="project-tile-meta">
          {%- if project.date %}<span class="project-tile-date">{% include project_date.liquid project=project format='%b %Y' %}</span>{% endif -%}
          {%- if project.description %}<span class="project-tile-description">{{ project.description }}</span>{% endif -%}
        </p>
      {% endif %}
    </div>
  </a>
</div>
